generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 15+ years Senior approach: Added Status, Upvotes, and Metadata for scalability
model Report {
  id            String   @id @default(uuid())
  title         String
  description   String
  category      String   @default("BOSHQA") // "YOL", "CHIROQ", "QUVUR", "XAVFSIZLIK", "IFLOSLIK", "BOSHQA"
  latitude      Float
  longitude     Float
  severityLevel String   // "CRITICAL", "HIGH", "MEDIUM", "LOW"
  status        String   @default("PENDING") // "PENDING", "IN_PROGRESS", "RESOLVED"
  upvotes       Int      @default(0)
  imageUrl      String?  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, severityLevel])
  @@index([category])
}
